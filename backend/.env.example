# Server
PORT=3001
NODE_ENV=development

# Database
DB_HOST=localhost
DB_PORT=5432
DB_USER=trazabilidad
DB_PASSWORD=trazabilidad123
DB_DATABASE=trazabilidad

# JWT - generar secretos fuertes antes de produccion
JWT_ACCESS_SECRET=cambiar_este_secreto_por_uno_largo_y_aleatorio
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=cambiar_este_secreto_refresh_por_otro_largo_y_aleatorio
JWT_REFRESH_EXPIRES_IN=7d

# CORS
CORS_ORIGIN=http://localhost:5173

# Cookie
COOKIE_SAMESITE=strict

# Password inicial del usuario admin (usada por create-admin.js)
ADMIN_INITIAL_PASSWORD=cambiar_esta_password_inicial